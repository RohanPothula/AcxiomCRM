@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Create Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-clean p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0">Create New Lead</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="LeadCode" class="form-label small fw-semibold">Lead Code</label>
                        <input asp-for="LeadCode" class="form-control" readonly />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LeadName" class="form-label small fw-semibold">Lead Contact Name <span class="text-danger">*</span></label>
                        <input asp-for="LeadName" class="form-control" placeholder="Rajesh Sharma" required />
                        <span asp-validation-for="LeadName" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="rajesh@example.com" required />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" placeholder="9876543210" required />
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Sharma Enterprises" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Source" class="form-label small fw-semibold">Lead Source</label>
                        <select asp-for="Source" class="form-select">
                            <option value="Website">Website</option>
                            <option value="Referral">Referral</option>
                            <option value="Cold Call">Cold Call</option>
                            <option value="Advertisement">Advertisement</option>
                            <option value="Partner">Partner</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Status" class="form-label small fw-semibold">Initial Status <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select">
                            @foreach (var st in AcxiomCRM.Models.LeadStatuses.All)
                            {
                                <option value="@st">@st</option>
                            }
                        </select>
                        <span asp-validation-for="Status" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Priority" class="form-label small fw-semibold">Priority</label>
                        <select asp-for="Priority" class="form-select">
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ExpectedValue" class="form-label small fw-semibold">Expected Value (₹)</label>
                        <input asp-for="ExpectedValue" type="number" step="0.01" class="form-control" placeholder="50000" />
                        <span asp-validation-for="ExpectedValue" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedTo" class="form-label small fw-semibold">Assign To Sales Executive</label>
                    <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- Assign Sales Executive --</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label small fw-semibold">Notes / Requirements</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                    <button type="submit" class="btn btn-primary-crm">Save Lead</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
