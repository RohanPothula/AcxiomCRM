@model AcxiomCRM.ViewModels.ConvertLeadViewModel
@{
    ViewData["Title"] = "Convert Lead";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-clean p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <div>
                    <h5 class="fw-bold mb-0">Convert Lead: @Model.LeadName</h5>
                    <div class="small text-muted">This workflow creates a permanent Customer account and optionally an Opportunity pipeline record.</div>
                </div>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Cancel</a>
            </div>

            <form asp-action="Convert" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LeadId" />
                <input type="hidden" asp-for="LeadName" />
                <input type="hidden" asp-for="Email" />
                <input type="hidden" asp-for="Phone" />
                <input type="hidden" asp-for="CompanyName" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <!-- Step 1: Customer Record Creation Details -->
                <div class="p-3 bg-light border rounded mb-3">
                    <h6 class="fw-bold mb-2">1. Customer Master Data (To Be Created / Linked)</h6>
                    <div class="row small">
                        <div class="col-md-6 mb-1"><strong>Name:</strong> @Model.LeadName</div>
                        <div class="col-md-6 mb-1"><strong>Email:</strong> @Model.Email</div>
                        <div class="col-md-6 mb-1"><strong>Phone:</strong> @Model.Phone</div>
                        <div class="col-md-6 mb-1"><strong>Company:</strong> @(Model.CompanyName ?? "Individual")</div>
                    </div>
                </div>

                <!-- Step 2: Opportunity Details -->
                <div class="mb-3 form-check">
                    <input asp-for="CreateOpportunity" class="form-check-input" id="createOppCheck" />
                    <label class="form-check-label fw-semibold" for="createOppCheck">
                        Create an Opportunity in sales pipeline
                    </label>
                </div>

                <div id="oppSection" class="border p-3 rounded mb-4">
                    <h6 class="fw-bold mb-3">2. Opportunity Information</h6>
                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                        <input asp-for="OpportunityName" class="form-control" />
                        <span asp-validation-for="OpportunityName" class="field-validation-error"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="OpportunityAmount" class="form-label small fw-semibold">Deal Amount (₹) <span class="text-danger">*</span></label>
                            <input asp-for="OpportunityAmount" type="number" step="0.01" class="form-control" />
                            <span asp-validation-for="OpportunityAmount" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Probability" class="form-label small fw-semibold">Win Probability (%)</label>
                            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" />
                            <span asp-validation-for="Probability" class="field-validation-error"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date</label>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" />
                            <span asp-validation-for="ExpectedCloseDate" class="field-validation-error"></span>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Details" asp-route-id="@Model.LeadId" class="btn btn-secondary-crm">Cancel</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check2-circle me-1"></i> Confirm & Convert Lead
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('createOppCheck').addEventListener('change', function () {
            document.getElementById('oppSection').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
