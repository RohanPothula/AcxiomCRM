@model IEnumerable<AcxiomCRM.ViewModels.UserListViewModel>
@{
    ViewData["Title"] = "User & Role Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">User & Role Management</h4>
        <div class="text-muted small">Manage enterprise user accounts, system roles, and access control</div>
    </div>
    <a asp-action="Create" class="btn btn-primary-crm">
        <i class="bi bi-person-plus me-1"></i> New User
    </a>
</div>

<!-- Search & Filters -->
<div class="card-clean p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Search by name or email..." />
        </div>
        <div class="col-md-4">
            <select name="role" class="form-select form-select-sm">
                <option value="">All Roles</option>
                <option value="Admin" selected="@(ViewBag.Role == "Admin")">Admin</option>
                <option value="Manager" selected="@(ViewBag.Role == "Manager")">Manager</option>
                <option value="Sales Executive" selected="@(ViewBag.Role == "Sales Executive")">Sales Executive</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary-crm">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Users Table -->
<div class="card-clean">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <div class="empty-state-title">No users found</div>
            <div class="small">No user records matched the criteria.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-crm">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Status</th>
                        <th>Lockout Status</th>
                        <th>Created Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.FullName</td>
                            <td>@u.Email</td>
                            <td><span class="badge bg-light text-dark border">@u.Role</span></td>
                            <td>
                                <span class="badge-clean @(u.IsActive ? "badge-active" : "badge-inactive")">
                                    @(u.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                @if (u.IsLockedOut)
                                {
                                    <span class="badge bg-danger">Locked Out</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Normal</span>
                                }
                            </td>
                            <td class="small text-muted">@u.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary py-0 px-2" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="ResetPassword" asp-route-id="@u.Id" class="btn btn-sm btn-outline-warning py-0 px-2" title="Reset Password">
                                    <i class="bi bi-key"></i>
                                </a>
                                <form asp-action="ToggleStatus" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm @(u.IsActive ? "btn-outline-danger" : "btn-outline-success") py-0 px-2" title="Toggle Active">
                                        <i class="bi @(u.IsActive ? "bi-person-x" : "bi-person-check")"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
