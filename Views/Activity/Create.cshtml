@model AcxiomCRM.Models.Activity
@{
    ViewData["Title"] = "Log Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-clean p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0">Log Sales Activity</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="ActivityType" class="form-label small fw-semibold">Activity Type <span class="text-danger">*</span></label>
                        <select asp-for="ActivityType" class="form-select">
                            @foreach (var tp in AcxiomCRM.Models.ActivityTypes.All)
                            {
                                <option value="@tp">@tp</option>
                            }
                        </select>
                        <span asp-validation-for="ActivityType" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ActivityDate" class="form-label small fw-semibold">Date & Time</label>
                        <input asp-for="ActivityDate" type="datetime-local" class="form-control" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label small fw-semibold">Subject / Heading <span class="text-danger">*</span></label>
                    <input asp-for="Subject" class="form-control" placeholder="Discovery call regarding Q4 requirements" required />
                    <span asp-validation-for="Subject" class="field-validation-error"></span>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CustomerId" class="form-label small fw-semibold">Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.CustomersList" class="form-select">
                            <option value="">-- None / Select Customer --</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LeadId" class="form-label small fw-semibold">Lead</label>
                        <select asp-for="LeadId" asp-items="ViewBag.LeadsList" class="form-select">
                            <option value="">-- None / Select Lead --</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="OpportunityId" class="form-label small fw-semibold">Opportunity</label>
                        <select asp-for="OpportunityId" asp-items="ViewBag.OpportunitiesList" class="form-select">
                            <option value="">-- None / Select Opportunity --</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedTo" class="form-label small fw-semibold">User Logged</label>
                    <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- Select User --</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Description" class="form-label small fw-semibold">Detailed Notes / Minutes</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                    <button type="submit" class="btn btn-primary-crm">Save Activity</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
