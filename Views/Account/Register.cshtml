@model AcxiomCRM.ViewModels.RegisterViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Register";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light px-3 py-5">
    <div class="card border shadow-sm p-4" style="max-width: 480px; width: 100%;">
        <div class="text-center mb-4">
            <h4 class="fw-bold mb-1">Create Account</h4>
            <p class="text-muted small mb-0">Join AcxiomCRM Sales Management</p>
        </div>

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label small fw-semibold">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. John Doe" required />
                <span asp-validation-for="FullName" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label small fw-semibold">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="name@company.com" required />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ConfirmPassword" class="form-label small fw-semibold">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="••••••••" required />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label small fw-semibold">Initial Role</label>
                <select asp-for="Role" class="form-select">
                    <option value="Sales Executive">Sales Executive</option>
                    <option value="Manager">Manager</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary-crm w-100 py-2">Create Account</button>
        </form>

        <div class="border-top mt-4 pt-3 text-center">
            <span class="small text-muted">Already registered?</span>
            <a asp-action="Login" class="small fw-semibold text-decoration-none ms-1">Sign In</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
