@model AcxiomCRM.ViewModels.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<div class="d-flex align-items-center justify-content-center min-vh-100 bg-light px-3 py-5">
    <div class="card border shadow-sm p-4" style="max-width: 420px; width: 100%;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center mb-2">
                <svg width="40" height="40" viewBox="0 0 64 64" fill="none">
                    <rect width="64" height="64" rx="8" fill="#1e293b"/>
                    <path d="M14 48 L32 14 L50 48 Z" stroke="#38bdf8" stroke-width="6"/>
                    <line x1="22" y1="36" x2="42" y2="36" stroke="#60a5fa" stroke-width="5"/>
                </svg>
            </div>
            <h4 class="fw-bold mb-1">AcxiomCRM</h4>
            <p class="text-muted small mb-0">Customer and Sales Management</p>
        </div>

        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

            <div class="mb-3">
                <label asp-for="EmailOrUsername" class="form-label small fw-semibold">Email or Username</label>
                <input asp-for="EmailOrUsername" class="form-control" autocomplete="username" placeholder="name@company.com" required />
                <span asp-validation-for="EmailOrUsername" class="field-validation-error"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" placeholder="••••••••" required />
                <span asp-validation-for="Password" class="field-validation-error"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label small">Remember this browser</label>
            </div>

            <button type="submit" class="btn btn-primary-crm w-100 py-2">Sign In</button>
        </form>

        <div class="border-top mt-4 pt-3 text-center">
            <span class="small text-muted">Need an account?</span>
            <a asp-action="Register" class="small fw-semibold text-decoration-none ms-1">Register</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
