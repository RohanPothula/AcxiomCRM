@{
    ViewData["Title"] = "System Error";
    var statusCode = Context.Request.Query["statusCode"].ToString();
}

<div class="row justify-content-center py-5">
    <div class="col-lg-6 text-center">
        <div class="card-clean p-5">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 3rem;"></i>
            <h4 class="fw-bold mt-3 mb-2">Request Could Not Be Processed</h4>
            @if (!string.IsNullOrEmpty(statusCode))
            {
                <p class="text-muted small">HTTP Status Code: <strong>@statusCode</strong></p>
            }
            <p class="text-muted small mb-4">
                An unexpected condition was encountered. The security and operational context of your request has been logged. Please try again or return to the main dashboard.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-crm">Back to Dashboard</a>
                <a href="javascript:history.back()" class="btn btn-secondary-crm">Previous Page</a>
            </div>
        </div>
    </div>
</div>
