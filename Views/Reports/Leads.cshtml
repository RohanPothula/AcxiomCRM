@model IEnumerable<AcxiomCRM.ViewModels.LeadReportItem>
@{
    ViewData["Title"] = "Lead Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Lead Report</h4>
        <div class="text-muted small">Lead acquisition sources, status, and conversion rates</div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="card-clean p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="source" class="form-select form-select-sm">
                <option value="">All Sources</option>
                <option value="Website" selected="@(ViewBag.Source == "Website")">Website</option>
                <option value="Referral" selected="@(ViewBag.Source == "Referral")">Referral</option>
                <option value="Cold Call" selected="@(ViewBag.Source == "Cold Call")">Cold Call</option>
                <option value="Advertisement" selected="@(ViewBag.Source == "Advertisement")">Advertisement</option>
                <option value="Partner" selected="@(ViewBag.Source == "Partner")">Partner</option>
            </select>
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var st in AcxiomCRM.Models.LeadStatuses.All)
                {
                    <option value="@st" selected="@(ViewBag.Status == st)">@st</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm btn-primary-crm">Apply Filter</button>
            <a asp-action="Leads" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card-clean">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-funnel"></i>
            <div class="empty-state-title">No lead data available for this report</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-crm">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>Expected Value</th>
                        <th>Converted?</th>
                        <th>Sales Executive</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="font-monospace small">@l.LeadCode</td>
                            <td class="fw-semibold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td>@(l.Source ?? "-")</td>
                            <td><span class="badge bg-light text-dark border">@l.Status</span></td>
                            <td class="fw-semibold">₹@l.ExpectedValue.ToString("N0")</td>
                            <td>
                                @if (l.IsConverted)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No</span>
                                }
                            </td>
                            <td class="small">@l.OwnerName</td>
                            <td class="small text-muted">@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
