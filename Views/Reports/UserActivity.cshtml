@model IEnumerable<AcxiomCRM.ViewModels.UserActivityReportItem>
@{
    ViewData["Title"] = "User Activity Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">User Activity Report</h4>
        <div class="text-muted small">Operational activity metrics by CRM user account</div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="card-clean">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-person-lines-fill"></i>
            <div class="empty-state-title">No user activity recorded</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-crm">
                <thead>
                    <tr>
                        <th>User Name</th>
                        <th>Role</th>
                        <th>Customers Created</th>
                        <th>Leads Assigned</th>
                        <th>Opportunities Assigned</th>
                        <th>Follow-Ups Completed</th>
                        <th>Activities Logged</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.UserName</td>
                            <td><span class="badge bg-light text-dark border">@u.Role</span></td>
                            <td>@u.CustomersCreated</td>
                            <td>@u.LeadsAssigned</td>
                            <td>@u.OpportunitiesAssigned</td>
                            <td><span class="badge bg-success-subtle text-success">@u.FollowUpsCompleted</span></td>
                            <td>@u.ActivitiesLogged</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
