@model IEnumerable<AcxiomCRM.ViewModels.CustomerReportItem>
@{
    ViewData["Title"] = "Customer Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Customer Report</h4>
        <div class="text-muted small">Account master records and allocation overview</div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="card-clean p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                <option value="Active" selected="@(ViewBag.Status == "Active")">Active</option>
                <option value="Inactive" selected="@(ViewBag.Status == "Inactive")">Inactive</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm btn-primary-crm">Apply Filter</button>
            <a asp-action="Customers" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card-clean">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-people"></i>
            <div class="empty-state-title">No customer data available for this report</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-crm">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Customer Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Status</th>
                        <th>Account Owner</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="font-monospace small">@c.CustomerCode</td>
                            <td class="fw-semibold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td class="small">@c.Email</td>
                            <td class="small">@c.Phone</td>
                            <td><span class="badge-clean @(c.Status == "Active" ? "badge-active" : "badge-inactive")">@c.Status</span></td>
                            <td class="small">@c.OwnerName</td>
                            <td class="small text-muted">@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
