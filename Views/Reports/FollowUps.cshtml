@model IEnumerable<AcxiomCRM.ViewModels.FollowUpReportItem>
@{
    ViewData["Title"] = "Follow-Up Report";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Follow-Up Report</h4>
        <div class="text-muted small">Status tracking, overdue tasks, and activity execution</div>
    </div>
    <div class="d-flex gap-2">
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> Print / Export
        </button>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Reports</a>
    </div>
</div>

<div class="card-clean p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var st in AcxiomCRM.Models.FollowUpStatuses.All)
                {
                    <option value="@st" selected="@(ViewBag.Status == st)">@st</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-sm btn-primary-crm">Apply Filter</button>
            <a asp-action="FollowUps" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<div class="card-clean">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <div class="empty-state-title">No follow-up data available for this report</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-crm">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Target Record</th>
                        <th>Scheduled Date</th>
                        <th>Status</th>
                        <th>Overdue?</th>
                        <th>Assigned Executive</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@f.Subject</td>
                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                            <td class="small">@f.TargetName</td>
                            <td class="small">@f.FollowUpDate.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge-clean @(f.Status == "Completed" ? "badge-won" : (f.Status == "Missed" ? "badge-lost" : "badge-new"))">
                                    @f.Status
                                </span>
                            </td>
                            <td>
                                @if (f.IsOverdue)
                                {
                                    <span class="badge bg-danger">Overdue</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No</span>
                                }
                            </td>
                            <td class="small">@f.OwnerName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
