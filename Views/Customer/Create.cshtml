@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Create Customer";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-clean p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0">Create New Customer</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CustomerCode" class="form-label small fw-semibold">Customer Code</label>
                        <input asp-for="CustomerCode" class="form-control" readonly />
                        <span asp-validation-for="CustomerCode" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CustomerName" class="form-label small fw-semibold">Customer Name <span class="text-danger">*</span></label>
                        <input asp-for="CustomerName" class="form-control" placeholder="Acme Technologies" required />
                        <span asp-validation-for="CustomerName" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label small fw-semibold">Email Address <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="contact@acme.com" required />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Phone" class="form-label small fw-semibold">Phone Number <span class="text-danger">*</span></label>
                        <input asp-for="Phone" class="form-control" placeholder="9876543210" required />
                        <span asp-validation-for="Phone" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CompanyName" class="form-label small fw-semibold">Company Name</label>
                        <input asp-for="CompanyName" class="form-control" placeholder="Acme Corp" />
                        <span asp-validation-for="CompanyName" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label small fw-semibold">Status</label>
                        <select asp-for="Status" class="form-select">
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Address" class="form-label small fw-semibold">Address</label>
                        <input asp-for="Address" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="City" class="form-label small fw-semibold">City</label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="State" class="form-label small fw-semibold">State</label>
                        <input asp-for="State" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="OwnerId" class="form-label small fw-semibold">Assigned Account Owner</label>
                    <select asp-for="OwnerId" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- Assign Owner --</option>
                    </select>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                    <button type="submit" class="btn btn-primary-crm">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
