@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Edit Opportunity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-clean p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0">Edit Opportunity: @Model.OpportunityName</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>

            <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="OpportunityId" />
                <input type="hidden" asp-for="CreatedDate" />
                <input type="hidden" asp-for="LeadId" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="OpportunityName" class="form-label small fw-semibold">Opportunity Name <span class="text-danger">*</span></label>
                    <input asp-for="OpportunityName" class="form-control" required />
                    <span asp-validation-for="OpportunityName" class="field-validation-error"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CustomerId" class="form-label small fw-semibold">Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.CustomersList" class="form-select">
                            <option value="">-- Select Customer --</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AssignedTo" class="form-label small fw-semibold">Assigned Sales Executive</label>
                        <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                            <option value="">-- Assign Sales Executive --</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Amount" class="form-label small fw-semibold">Amount (₹) <span class="text-danger">*</span></label>
                        <input asp-for="Amount" type="number" step="0.01" class="form-control" required />
                        <span asp-validation-for="Amount" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Probability" class="form-label small fw-semibold">Win Probability (0-100)% <span class="text-danger">*</span></label>
                        <input asp-for="Probability" type="number" min="0" max="100" class="form-control" required />
                        <span asp-validation-for="Probability" class="field-validation-error"></span>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="ExpectedCloseDate" class="form-label small fw-semibold">Expected Close Date <span class="text-danger">*</span></label>
                        <input asp-for="ExpectedCloseDate" type="date" class="form-control" asp-format="{0:yyyy-MM-dd}" required />
                        <span asp-validation-for="ExpectedCloseDate" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Stage" class="form-label small fw-semibold">Pipeline Stage <span class="text-danger">*</span></label>
                        <select asp-for="Stage" class="form-select">
                            @foreach (var stg in AcxiomCRM.Models.OpportunityStages.All)
                            {
                                <option value="@stg">@stg</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Source" class="form-label small fw-semibold">Source</label>
                        <input asp-for="Source" class="form-control" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Notes" class="form-label small fw-semibold">Deal Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                    <button type="submit" class="btn btn-primary-crm">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
