@model AcxiomCRM.Models.FollowUp
@{
    ViewData["Title"] = "Schedule Follow-Up";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card-clean p-4">
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                <h5 class="fw-bold mb-0">Schedule Follow-Up</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to List</a>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label small fw-semibold">Subject / Purpose <span class="text-danger">*</span></label>
                    <input asp-for="Subject" class="form-control" placeholder="Product demonstration with procurement lead" required />
                    <span asp-validation-for="Subject" class="field-validation-error"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FollowUpType" class="form-label small fw-semibold">Follow-Up Type <span class="text-danger">*</span></label>
                        <select asp-for="FollowUpType" class="form-select">
                            <option value="Call">Call</option>
                            <option value="Meeting">Meeting</option>
                            <option value="Email">Email</option>
                            <option value="Task">Task</option>
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="FollowUpDate" class="form-label small fw-semibold">Follow-Up Date & Time <span class="text-danger">*</span></label>
                        <input asp-for="FollowUpDate" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FollowUpDate" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="CustomerId" class="form-label small fw-semibold">Related Customer</label>
                        <select asp-for="CustomerId" asp-items="ViewBag.CustomersList" class="form-select">
                            <option value="">-- None / Select Customer --</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="LeadId" class="form-label small fw-semibold">Related Lead</label>
                        <select asp-for="LeadId" asp-items="ViewBag.LeadsList" class="form-select">
                            <option value="">-- None / Select Lead --</option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="OpportunityId" class="form-label small fw-semibold">Related Opportunity</label>
                        <select asp-for="OpportunityId" asp-items="ViewBag.OpportunitiesList" class="form-select">
                            <option value="">-- None / Select Opportunity --</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="AssignedTo" class="form-label small fw-semibold">Assigned Sales Executive</label>
                    <select asp-for="AssignedTo" asp-items="ViewBag.UsersList" class="form-select">
                        <option value="">-- Assign Sales Executive --</option>
                    </select>
                </div>

                <div class="mb-4">
                    <label asp-for="Remarks" class="form-label small fw-semibold">Remarks / Context</label>
                    <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                    <button type="submit" class="btn btn-primary-crm">Schedule Follow-Up</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
