@model IEnumerable<AcxiomCRM.Models.FollowUp>
@{
    ViewData["Title"] = "Follow-Up Management";
    var today = DateTime.UtcNow.Date;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h4 class="fw-bold mb-0">Follow-Ups</h4>
        <div class="text-muted small">Schedule, reschedule, and complete client communications</div>
    </div>
    <a asp-action="Create" class="btn btn-primary-crm">
        <i class="bi bi-calendar-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Filters -->
<div class="card-clean p-3 mb-3">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="">All Statuses</option>
                @foreach (var st in AcxiomCRM.Models.FollowUpStatuses.All)
                {
                    <option value="@st" selected="@(ViewBag.Status == st)">@st</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <select name="type" class="form-select form-select-sm">
                <option value="">All Types</option>
                <option value="Call" selected="@(ViewBag.Type == "Call")">Call</option>
                <option value="Meeting" selected="@(ViewBag.Type == "Meeting")">Meeting</option>
                <option value="Email" selected="@(ViewBag.Type == "Email")">Email</option>
                <option value="Task" selected="@(ViewBag.Type == "Task")">Task</option>
            </select>
        </div>
        <div class="col-md-3">
            <input type="date" name="date" value="@ViewBag.Date" class="form-control form-control-sm" />
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary-crm">Filter</button>
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
        </div>
    </form>
</div>

<!-- Table -->
<div class="card-clean">
    @if (!Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-calendar-x"></i>
            <div class="empty-state-title">No follow-ups scheduled</div>
            <div class="small">No tasks match your filter criteria.</div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table-crm">
                <thead>
                    <tr>
                        <th>Subject</th>
                        <th>Type</th>
                        <th>Scheduled Date</th>
                        <th>Target Record</th>
                        <th>Status</th>
                        <th>Assigned To</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in Model)
                    {
                        bool isOverdue = f.Status == AcxiomCRM.Models.FollowUpStatuses.Planned && f.FollowUpDate.Date < today;
                        <tr class="@(isOverdue ? "table-danger-subtle" : "")">
                            <td>
                                <div class="fw-semibold">@f.Subject</div>
                                @if (!string.IsNullOrEmpty(f.Remarks))
                                {
                                    <div class="small text-muted">@f.Remarks</div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@f.FollowUpType</span></td>
                            <td class="small @(isOverdue ? "text-danger fw-bold" : "")">
                                @f.FollowUpDate.ToString("dd MMM yyyy HH:mm")
                                @if (isOverdue)
                                {
                                    <span class="badge bg-danger ms-1">Overdue</span>
                                }
                            </td>
                            <td class="small">
                                @if (f.Customer != null)
                                {
                                    <a asp-controller="Customer" asp-action="Details" asp-route-id="@f.CustomerId" class="text-decoration-none">@f.Customer.CustomerName</a>
                                }
                                else if (f.Lead != null)
                                {
                                    <a asp-controller="Lead" asp-action="Details" asp-route-id="@f.LeadId" class="text-decoration-none">@f.Lead.LeadName (Lead)</a>
                                }
                                else if (f.Opportunity != null)
                                {
                                    <a asp-controller="Opportunity" asp-action="Details" asp-route-id="@f.OpportunityId" class="text-decoration-none">@f.Opportunity.OpportunityName (Opp)</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td>
                                <span class="badge-clean @(f.Status == "Completed" ? "badge-won" : (f.Status == "Missed" ? "badge-lost" : "badge-new"))">
                                    @f.Status
                                </span>
                            </td>
                            <td class="small">@(f.Assignee != null ? f.Assignee.FullName : "Unassigned")</td>
                            <td class="text-end">
                                @if (f.Status == AcxiomCRM.Models.FollowUpStatuses.Planned)
                                {
                                    <form asp-action="Complete" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success py-0 px-2" title="Mark Completed">
                                            <i class="bi bi-check-lg"></i>
                                        </button>
                                    </form>

                                    <form asp-action="MarkMissed" asp-route-id="@f.FollowUpId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-warning py-0 px-2" title="Mark Missed">
                                            <i class="bi bi-x-circle"></i>
                                        </button>
                                    </form>

                                    <!-- Reschedule Modal Trigger -->
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2" data-bs-toggle="modal" data-bs-target="#rescheduleModal-@f.FollowUpId" title="Reschedule">
                                        <i class="bi bi-arrow-repeat"></i>
                                    </button>

                                    <!-- Modal -->
                                    <div class="modal fade text-start" id="rescheduleModal-@f.FollowUpId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="Reschedule" asp-route-id="@f.FollowUpId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header">
                                                        <h6 class="modal-title fw-bold">Reschedule Follow-Up: @f.Subject</h6>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">New Date & Time (must not be earlier than today)</label>
                                                            <input type="datetime-local" name="newDate" class="form-control" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label small fw-semibold">Remarks</label>
                                                            <input type="text" name="remarks" class="form-control" placeholder="Reason for rescheduling" />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-sm btn-secondary-crm" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-sm btn-primary-crm">Confirm Reschedule</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (ViewBag.TotalPages > 1)
        {
            <div class="p-3 border-top d-flex justify-content-between align-items-center">
                <span class="small text-muted">Page @ViewBag.CurrentPage of @ViewBag.TotalPages</span>
                <ul class="pagination pagination-sm mb-0">
                    @for (int p = 1; p <= ViewBag.TotalPages; p++)
                    {
                        <li class="page-item @(p == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@ViewBag.Status" asp-route-type="@ViewBag.Type" asp-route-date="@ViewBag.Date">@p</a>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>
